{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "carapecos-online",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "carapecos-online",
			// Paste the production database_id from the Cloudflare
			// "keep deployments in sync" box (Workers → Settings → Bindings).
			"database_id": "PASTE_PRODUCTION_D1_ID",
			// Remote `wrangler dev` keeps using the old teste database
			"preview_database_id": "82d67596-f4da-42c3-8a83-97d564689cb0",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "carapecos-online-prod"
		}
	],
	"vars": {
		"S3_BUCKET": "carapecos-online-prod",
		"S3_REGION": "auto"
	},
	"workers_dev": true,
	"preview_urls": true
}
