{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "carapecos-online",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "carapecos-online",
			"database_id": "61e8269f-b034-4328-a3f6-0ac9399e8a5f",
			// Remote `wrangler dev` keeps using the old teste database
			"preview_database_id": "82d67596-f4da-42c3-8a83-97d564689cb0",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "carapecos-online-prod"
		}
	],
	// Public runtime config. Do not put BETTER_AUTH_SECRET, S3_ACCESS_KEY_ID
	// or S3_SECRET_ACCESS_KEY here — those stay as Encrypted secrets in the
	// dashboard (a deploy never deletes them).
	"vars": {
		"ORIGIN": "https://carapecos.com",
		"S3_ENDPOINT": "https://ad77d629a3e505399d98f56b587f9189.r2.cloudflarestorage.com",
		"S3_REGION": "auto",
		"S3_BUCKET": "carapecos-online-prod",
		"MEDIA_BASE_URL": "https://ad77d629a3e505399d98f56b587f9189.r2.cloudflarestorage.com/carapecos-online-prod",
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
		"VAPID_PUBLIC_KEY": "",
		"VAPID_SUBJECT": "mailto:geral@carapecos.com",
		"CF_ANALYTICS_TOKEN": ""
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": false
		}
	}
}
