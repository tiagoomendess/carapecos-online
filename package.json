{
	"name": "carapecos-online",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.service-worker.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"import": "tsx scripts/import/index.ts",
		"vapid": "tsx scripts/vapid-keys.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"cheerio": "^1.2.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@block65/webcrypto-web-push": "^2.0.0",
		"@jsquash/webp": "^1.5.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-table": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"aws4fetch": "^1.0.20",
		"dom-serializer": "^3.1.1",
		"domhandler": "^6.0.1",
		"domutils": "^4.0.2",
		"htmlparser2": "^12.0.0"
	}
}
