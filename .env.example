# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# File storage (S3 API): LocalStack in development, R2 in production
# R2: S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", S3_REGION="auto"
S3_ENDPOINT="http://localhost:4566"
S3_REGION="us-east-1"
S3_BUCKET="carapecos-media"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
# Public base URL images are served from (an R2 custom domain in production)
MEDIA_BASE_URL="http://localhost:4566/carapecos-media"

# Cloudflare Turnstile (comments, votes, contact form). These are Cloudflare's test keys, which
# always pass; production uses the keys of a Turnstile widget for carapecos.com
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Web push (VAPID). Generate once with `npm run vapid`; production needs its own pair
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:geral@carapecos.com"

# Cloudflare Web Analytics token (empty: no analytics)
CF_ANALYTICS_TOKEN=""
